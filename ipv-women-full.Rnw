<<splines-verify-alignment, results="asis", echo = FALSE, eval = FALSE>>=
library(xtable)
print(xtable(check.alignment.tab, label = "tab:alignment", caption = "Verify that the model matrix and the parameters matrix are aligned, ie that the column ordering is the same in both."), booktabs = TRUE)
@
\end{footnotesize}

<<splines-verify-alignment-2, results="asis", echo = FALSE>>=
library(xtable)
## Resizing a table from this
## print(xtable(check.alignment.tab, label = "tab:alignment", caption = "Verify that the model matrix and the parameters matrix are aligned, ie that the column ordering is the same in both."), booktabs = TRUE)

## to this
cat("\\begin{table}[ht]\n\\centering\n\\resizebox{\\textwidth}{!}{%\n")
print(
  xtable(check.alignment.tab),
  include.rownames = FALSE,
  booktabs = TRUE,
  floating = FALSE
)
cat("}\n\\caption{Verify that the model matrix and the parameters matrix are aligned, ie that the column ordering is the same in both.}\n")
