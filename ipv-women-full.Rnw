@ 

<<simple.predictions>>=
simple.predictions.f <- function(parameters, data, variables.to.vary, grouping.variable = NULL, my.probs = c(0.025, 0.5, 0.975), n.points = 10){

    ## assume input is already in good shape, names in the data matches names in parameters
    ## input can have extra columns, remove them.
    ## And add a Intercept column
    data$Intercept <- rep(1, nrow(data))
    keep.these.columns <- match(colnames(parameters), colnames(data))
    if(length(keep.these.columns) != length(colnames(parameters))){
        return(NULL)
    }

    data <- data[keep.these.columns]

    ## convert "True" "False" to 1 and 0
    my.recodes <- "'True' = 1; 'False' = 0"
    for(i in as.vector(which(sapply(data, class) == "character"))){
        data[[i]] <- globallivingconditions::recode(data[[i]], recodes = my.recodes)
    }

    ## get the sample means
    baseline <- apply(data, 2, mean)

    ## For now assume focal variable is not a factor.
    
    ## For each of these, find an appropriate quantile for predictions, say
    ## the values between quantiles 0.1 and 0.9
    predict.at <- sapply(variables.to.vary, function(var) {
        boundaries <- quantile(data[[var]], probs = c(0.1, 0.9))
        seq(from = boundaries[1], to = boundaries[2], length.out = n.points)
    })
    
    ## single case, numeric focal variable
    my.model.matrix <- matrix(rep(baseline, n.points), nrow = n.points, byrow = TRUE)
    colnames(my.model.matrix) <- names(baseline)
    ## modify the focal variable.
    my.model.matrix[, variables.to.vary] <- predict.at[, variables.to.vary]
    ## ## you could do the matrix multiplication in one go, like this
    ## logits <- plogis(parameters %*% t(my.model.matrix))
    ## ## but then you neeed to loop over the columns anyway to get the quantiles
    ## results <- apply(logits, 2, quantile, probs = my.probs)
    ## ## still that looks nicer than 
    ## results.2 <- apply(my.model.matrix, 1, function(x) {
    ##     quantile(plogis(parameters %*% x), probs = my.probs)
    ## })
    ## ## Having that said, everyone loves a oneliner
    results <- apply(plogis(parameters %*% t(my.model.matrix)), 2, quantile, probs = my.probs)
    colnames(results) <- predict.at
    return(results)
}

@

<<base-model-plot, fig.cap = "Left: Predicted probabilities of IPV for typical values of Neighbourhood justification of IPV. Right: Predicted probabilities of IPV for the typical values of the Gender Development Index. Typical values defined as the values above the 10th percentile and below the 90th percentile. Predictions based on the base model and the other variabels in the model set to their mean values. Credible intervals based 95\\% of the sampled parameters.", fig.width = 6, fig.height = 3.5, dependson = "base-model">>=
par(mfcol = c(1, 2), cex.lab = 0.7, cex.axis = 0.7)
predictions <- simple.predictions.f(
    parameters = as.matrix(read.csv("ipv-women-basemodel.csv", check.names = FALSE)),
    data = ipv.mm, variables.to.vary = "justifyIPV_cluster")
plot(x = as.numeric(colnames(predictions)), y = predictions["50%", ], typ = "l", ylim = c(min(predictions), max(predictions)), xlab = "Neighbourhood justification of IPV", ylab = "Predicted probability of IPV")
lines(x = as.numeric(colnames(predictions)), y = predictions["2.5%", ], lty = 2)
lines(x = as.numeric(colnames(predictions)), y = predictions["97.5%", ], lty = 2)
grid()

predictions <- simple.predictions.f(
    parameters = as.matrix(read.csv("ipv-women-basemodel.csv", check.names = FALSE)),
    data = ipv.mm, variables.to.vary = "gdi")

plot(x = as.numeric(colnames(predictions)), y = predictions["50%", ], typ = "l", ylim = c(min(predictions), max(predictions)), xlab = "Gender Development Index", ylab = "Predicted probability of IPV")
lines(x = as.numeric(colnames(predictions)), y = predictions["2.5%", ], lty = 2)
lines(x = as.numeric(colnames(predictions)), y = predictions["97.5%", ], lty = 2)
grid()

