<<spline-gdi-dual-plot-without-splines, fig.cap = paste0("Left: Predicted probabilities for a woman to be exposed to IPV conditioned on the Gender Development Index. Credible intervals corresponding to 95\\% of the parameter samples. Right: Upper bounds of the credible intervals of the marginal effect of the Gender Development Index on the probability of IPV in different types of couples. For most types of couples the effect of the GDI becomes 'statistically significant' at about the same level of GDI, about 0.32, but for couples where only the husband thinks IPV can be justified, GDI needs to be higher before its effect becomes statistical significant. n = ", nrow(ipv.mm), "."), fig.width = 5, fig.height = 3.3, dpi = 300>>=
## Layout: 2 rows, one for plots, one for legend
layout(matrix(c(1, 1, 2, 3), nrow = 2, byrow = TRUE), heights = c(1, 4))

raw.x <- interesting.points

## Legend 
par(mar = c(0, 0, 0, 0))
plot.new()
legend("center",
       title = "Justifications in the couple",
       legend = c("No one justifies IPV", "Only Husband justifies IPV", 
                  "Only Wife justifies IPV", "Wife & husband justify IPV"), 
       col = c("darkgreen", "orange", "blue", "red"),
       lwd = 2, 
       lty = c(1, 4, 2, 3), 
       bty = "n", 
       ncol = 2,
       cex = 0.9)

## Left plot
par(mar = c(4, 4, 2, 1), cex.axis = 0.6, cex.lab = 0.7, cex.main = 0.7)
plot(y = results[["None justifys IPV"]]["50%",],
     x = raw.x,
     xlab = "Gender Development Index",
     ylab = "Probability of IPV",
     main = "Predicted probabilities",     
     type = "l", col = "red", ylim = c(min(unlist(results)), max(unlist(results))),
     lwd = 1)
grid()
my.cols <- c("darkgreen", "red", "orange", "blue")
my.alpha.cols <- sapply(my.cols, cooltools::transparent, alpha = 0.4)
my.names <- c("None justifys IPV", attitudes.i)
for(i in 1:length(my.names)){
    polygon(y = c(results[[my.names[i]]]["2.5%",], rev(results[[my.names[i]]]["97.5%",])),
            x = c(raw.x, rev(raw.x)), col = my.alpha.cols[i], border = NA)
    lines(y = results[[my.names[i]]]["50%",],
          x = raw.x,
          col = my.cols[i], lwd = 1, lty = i)
}

## Right plot
plot(y = results.marginal[["None justifys IPV"]]["97.5%",],
     x = raw.x,
     xlab = "Gender Development Index",
     ylab = "Marginal effect on IPV (upper bound)",
     type = "l", col = "white",
     ylim = c(min(results.marginal[["('interaction_terms', 'Wife justifies IPV')"]]["97.5%",]),
              max(results.marginal[["('interaction_terms', 'Wife justifies IPV')"]]["97.5%",])),
     main = "Marginal effect (upper bound)",
     lwd = 1)
grid()
my.names <- c("None justifys IPV", attitudes.i)
for(i in 1:length(my.names)){
    lines(y = results.marginal[[my.names[i]]]["97.5%",],
          x = raw.x,
          col = my.cols[i], lwd = 2, lty = i)
}
abline(h = 0, lty = 2)
## Add some visual hints for interpretation.
for(i in 2:3){
    segments(x0=marginal.effect.negative.without.splines.at[i],
             y0=-0.0075, y1=0.0075, col = my.cols[i], lwd = 1)
    ## odd i:s above, even i:s below the x-axis
    my.y <- -0.0125 * 3 * (-1)^i
    text(x = marginal.effect.negative.without.splines.at[i],
         y = my.y,
         labels=round(marginal.effect.negative.without.splines.at[i], 2),
         col = my.cols[i], adj = 0.5, cex = 0.5)    
}

