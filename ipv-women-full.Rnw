\subsection{Marginal effect of the Gender Development Index}
% Figure \vref{fig:splines-gdi-plot-predictions} shows predicted probablities for the wife to have experienced violence from her current husband, and while visual inspection of that graph can give insight in how large proportion of the women in the neibourhood must think that IPV can be justified before we can say that probability of IPV increases, let us quantify this properly.

<<splines-gdi-marginal.effect.of.neighbourhood-without-splines>>=
results.marginal <- sapply(mms, function(my.mm){
    my.prob <- plogis(params.matrix %*% t(my.mm))
    ## 2000 samples, 78 cases, for different values on the 3 splines,
    ## ordered so that row 1 has 0 on all splines and row 78 has 1.0 on
    ## spline 2, representing all that all women in the neighbourhood
    ## thinks IPV can be justfied.

    ## my.prob is transformed so it has 78 columns
    ## Calculate the quantity difference between the first column and the
    ## current column for all columns.

    ## To get meaningful uncertainty estimates, use independent
    ## samples of the sampled parameters for the first row and for the
    ## other row.

    ## Do not necessarily test against the first column, with splines that
    ## might fail to find anything 'significant'

    ## assume the marginal effect is negative, and thus locate the maximum
    means <- apply(my.prob, 2, mean)
    first.column.that.has.maxium.mean <- head(which(means == max(means)), 1)
    
    sapply(1:ncol(my.prob), function(i) {
        ## To get smooth results, do this many times for each column
        diffs.against.some.column <- replicate(n=200, {
            single.result <- my.prob[sample(nrow(my.prob)), i] -
                my.prob[sample(nrow(my.prob)), first.column.that.has.maxium.mean] 
            quantile(single.result, probs = my.probs)
        })
        ## Use the mean of the quantiles for each column
        apply(diffs.against.some.column, 1, mean)
    })
}, simplify = FALSE)

@

<<marginal.effect.positive.at-without-splines>>=
## Find the points where the lines intersect the X-axis.
marginal.effect.negative.without.splines.at <- sapply(names(results.marginal), function(attitude){
    index.2 <- head(which(results.marginal[[attitude]]["97.5%",] <= 0), 1)
    index.1 <- index.2 - 1
    x.2 <- interesting.points[index.2]
    x.1 <- interesting.points[index.1]
    y.1 <- results.marginal[[attitude]]["97.5%", ][index.1]
    y.2 <- results.marginal[[attitude]]["97.5%", ][index.2]
    ## interpolate the x value
    ## calculate the slope
    slope = (y.2 - y.1)/(x.2-x.1)
    ## given this rate of change, how much do we need to x.1 to get the intersection point?
    needed.change <- abs(y.1)
    x <- abs(needed.change/slope) + x.1
})

@ 

<<splines-gdi-plot-marginal-effect-without-splines, fig.cap = paste0("Upper bounds of the credible intervals of the marginal effect of the Gender Development Index on the probability of IPV in different types of couples. n = ", nrow(ipv.mm), "."), fig.height=3, fig.width = 6, fig.align = "center", dev="png">>=
par(mar = c(4, 5, 1, 14))
plot(y = results.marginal[["None justifys IPV"]]["97.5%",],
     x = interesting.points,
     xlab = "Gender Development Index",
     ylab = "Marginal effect on IPV (upper bound)",
     type = "l", col = "white",
     ylim = c(min(results.marginal[["('interaction_terms', 'Wife justifies IPV')"]]["97.5%",]),
              max(results.marginal[["('interaction_terms', 'Wife justifies IPV')"]]["97.5%",])),
     lwd = 1)
grid()
my.names <- c("None justifys IPV", attitudes.i)
for(i in 1:length(my.names)){
    lines(y = results.marginal[[my.names[i]]]["97.5%",],
          x = interesting.points,
          col = my.cols[i], lwd = 3, lty = 1)
}
abline(h = 0, lty = 2)

## Add some hints.
for(i in 1:4){
    segments(x0=marginal.effect.negative.without.splines.at[i], y0=-0.0075, y1=0.0075, col = my.cols[i], lwd = 1)
    ## odd i:s above, even i:s below.
    my.y <- -0.0125 * (-1)^i
    text(x=marginal.effect.negative.without.splines.at[i], y = my.y,
         labels=round(marginal.effect.negative.without.splines.at[i], 2), col = my.cols[i], adj = 0.5, cex = 0.5)    
}

legend("right",
       title = "Justifications in the couple",
       legend = c("No one justifies IPV", "Husband justifies IPV", 
                  "Wife justifies IPV", "Wife & husband justify IPV"), 
       col = c("darkgreen", "orange", "blue", "red"),
       lwd = 3, 
       lty = 1, 
       bty = "n", 
       ncol = 1,
       inset = c(-1.3, 0),
       xpd = TRUE
)

